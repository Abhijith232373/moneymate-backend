
# ── Infrastructure ──────────────────────────────
POSTGRES_USER=superuser
POSTGRES_PASSWORD=
POSTGRES_DB=moneymate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

ENVIRONMENT=dev

# ── JWT ────────────────────────────────────────────────
# Must match auth-svc's signing secrets — payment-svc verifies tokens,
# it never issues them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
