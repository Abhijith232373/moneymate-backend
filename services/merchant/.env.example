# ── Server ──────────────────────────────────────
HTTP_PORT=9092

# ── Database ────────────────────────────────────
# Ensure strict database isolation (no sharing with auth)
POSTGRES_USER=merchant_user
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=moneymate_merchant

# ── Environment ─────────────────────────────────
ENVIRONMENT=dev

# ── Payment Gateway (Razorpay) ──────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=